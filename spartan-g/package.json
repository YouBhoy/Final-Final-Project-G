{
  "name": "spartan-g",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync:assessment-catalog": "node scripts/sync-assessment-catalog.mjs",
    "test:assessment-catalog": "node --test scripts/assessment-catalog.test.mjs",
    "test:appointments:spark": "firebase emulators:exec --project demo-spartan-booking --config firebase.booking-test.json --only firestore \"node --test firebase/functions/test/sparkAppointments.test.mjs firebase/functions/test/facilitatorAccess.test.mjs\"",
    "mobile": "npm run start --workspace=@spartan-g/mobile",
    "web": "npm run dev --workspace=@spartan-g/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build --workspace=@spartan-g/web",
    "build:web:production": "node scripts/build-web-production.mjs",
    "dev:statistics": "firebase emulators:exec --project demo-spartan-statistics --config firebase.statistics-demo.json --only auth,firestore,storage \"node scripts/statistics-demo.mjs\""
  },
  "devDependencies": {
    "firebase-admin": "^14.3.0",
    "typescript": "~5.3.0"
  }
}
