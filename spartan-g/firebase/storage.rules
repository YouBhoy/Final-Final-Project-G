rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.isActive == true;
    }

    function isFacilitatorOrAdmin() {
      return isActiveUser()
        && userDoc().data.role in ['facilitator', 'super_admin'];
    }

    function isSuperAdmin() {
      return isActiveUser() && userDoc().data.role == 'super_admin';
    }

    function isOwner(uid) {
      return isActiveUser() && request.auth.uid == uid;
    }

    function isConversationParticipant(conversationId) {
      return isActiveUser()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isValidDocument() {
      return request.resource.contentType in [
        'application/pdf',
        'image/jpeg',
        'image/png',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ] && request.resource.size < 20 * 1024 * 1024;
    }

    // User avatars — owner only
    match /avatars/{userId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // Assignment submissions — students upload, facilitators read
    match /assignments/{courseId}/{assignmentId}/{userId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isOwner(userId) && isValidDocument();
      allow delete: if isOwner(userId) || isFacilitatorOrAdmin();
    }

    // Course media — facilitators and admins only
    match /courses/{courseId}/{allPaths=**} {
      allow read: if isActiveUser();
      allow write, delete: if isFacilitatorOrAdmin();
    }

    // Message attachments
    match /messages/{conversationId}/{fileName} {
      allow read: if isSuperAdmin() || isConversationParticipant(conversationId);
      allow write: if isConversationParticipant(conversationId) && isValidDocument();
      allow delete: if isSuperAdmin() || (isFacilitatorOrAdmin() && isConversationParticipant(conversationId));
    }

    // Shared resource-library files — Super Admin uploads/replaces/removes,
    // every active user can read/download. No other role can write here,
    // even by calling Storage directly from the browser.
    match /resources/{resourceId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin() && isValidDocument();
      allow delete: if isSuperAdmin();
    }
  }
}
