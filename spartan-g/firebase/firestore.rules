rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.isActive == true;
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isStudent() {
      return isActiveUser() && userRole() == 'student';
    }

    function isFacilitator() {
      return isActiveUser() && userRole() == 'facilitator';
    }

    function isSuperAdmin() {
      return isActiveUser() && userRole() == 'super_admin';
    }

    function isFacilitatorOrAdmin() {
      return isFacilitator() || isSuperAdmin();
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAssignedFacilitator(studentId) {
      let link = get(/databases/$(database)/documents/facilitator_student_links/$(request.auth.uid + '_' + studentId));
      return isFacilitator()
        && link.data.facilitatorId == request.auth.uid
        && link.data.studentId == studentId
        && link.data.status == 'accepted';
    }

    function canReadStudent(studentId) {
      return isSuperAdmin() || isAssignedFacilitator(studentId);
    }

    function studentIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['studentId', 'assessmentId', 'attemptNumber', 'templateId', 'courseId', 'isPublished']);
    }

    function validLink(linkId, data) {
      return data.keys().hasAll(['studentId', 'facilitatorId', 'status', 'requestedAt'])
        && data.keys().hasOnly(['studentId', 'facilitatorId', 'status', 'requestedAt', 'respondedAt', 'notes', 'createdAt', 'updatedAt'])
        && data.studentId is string && data.facilitatorId is string
        && linkId == data.facilitatorId + '_' + data.studentId
        && data.status in ['pending', 'accepted', 'rejected']
        && get(/databases/$(database)/documents/users/$(data.studentId)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(data.facilitatorId)).data.role == 'facilitator'
        && get(/databases/$(database)/documents/users/$(data.facilitatorId)).data.isActive == true;
    }

    // ─── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId)
        || isSuperAdmin()
        || (resource.data.role == 'student' && isAssignedFacilitator(userId))
        || (isStudent() && resource.data.role == 'facilitator' && resource.data.isActive == true);
      // Public signup is student-only. Staff accounts must be provisioned
      // by a trusted backend or an existing active super admin.
      allow create: if isAuthenticated()
        && (
          (request.auth.uid == userId
            && validStudentRegistration(userId))
          || isSuperAdmin()
        );
      // Students cannot edit their own account/profile fields (campus, displayName,
      // photoURL, email, role, ...): profile changes go through a super admin
      // (adminUpdateStudentProfile). The only key a student client may still touch is
      // updatedAt, which the shared repository stamps on every write.
      // Facilitators keep editing their own profile, except role and isActive.
      allow update: if isSuperAdmin()
        || (isOwner(userId)
          && resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
        || (isOwner(userId)
          && resource.data.role != 'student'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive']));
      allow delete: if isSuperAdmin();
    }

    function validStudentRegistration(userId) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'campus', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'campus', 'isActive', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.role == 'student'
        && data.isActive == true
        && data.email is string
        && data.displayName is string
        && data.campus is string
        && data.campus.size() > 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // ─── Profiles ──────────────────────────────────────────────
    match /profiles/{userId} {
      allow read: if isOwner(userId)
        || canReadStudent(userId)
        || (isStudent() && get(/databases/$(database)/documents/users/$(userId)).data.role == 'facilitator' && get(/databases/$(database)/documents/users/$(userId)).data.isActive == true);
      // Students are read-only on their own profile. They may only create the
      // initial {uid, campus} document at registration; everything after that is
      // managed by a super admin. Facilitators keep editing their own profile.
      allow create: if isSuperAdmin()
        || (isOwner(userId)
          && (get(/databases/$(database)/documents/users/$(userId)).data.role != 'student'
            || request.resource.data.keys().hasOnly(['uid', 'campus', 'createdAt', 'updatedAt'])));
      allow update: if isSuperAdmin()
        || (isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.role != 'student');
      allow delete: if isSuperAdmin();
    }

    // ─── Campuses (admin-managed directory) ───────────────────
    // Active users can read active campuses for registration, profiles, and
    // facilitator filtering. Super Admins can manage the directory, but
    // deletion is intentionally disabled so existing user references remain valid.
    match /campuses/{campusId} {
      allow read: if isSuperAdmin() || resource.data.isActive == true;
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // ─── Resources (shared library behind every /resources page) ──
    // Read: any active user. Non-admins may only LIST published entries
    // (their query must include isActive == true to be provable), while a
    // Super Admin may list everything.
    // Write: Super Admin only — students/facilitators can never mutate
    // the library, even by calling Firestore directly.
    match /resources/{resourceId} {
      allow read: if isSuperAdmin()
        || (isStudent()
          && resource.data.isActive == true
          && resource.data.audience in ['all', 'students'])
        || (isFacilitator()
          && resource.data.isActive == true
          && resource.data.audience in ['all', 'facilitators']);
      allow create, update, delete: if isSuperAdmin();
    }

    // ─── Courses ───────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isActiveUser()
        && (resource.data.isPublished == true || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Enrollments ───────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || canReadStudent(resource.data.studentId));
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isSuperAdmin()
        || (studentIdentityUnchanged()
          && (isAssignedFacilitator(resource.data.studentId)
            || (isStudent() && resource.data.studentId == request.auth.uid)));
      allow delete: if canReadStudent(resource.data.studentId);
    }

    // ─── Assignments ───────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Submissions ───────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || canReadStudent(resource.data.studentId));
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isSuperAdmin()
        || (studentIdentityUnchanged() && isAssignedFacilitator(resource.data.studentId))
        || (studentIdentityUnchanged() && isStudent()
          && resource.data.studentId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'feedback']));
      allow delete: if canReadStudent(resource.data.studentId);
    }

    // ─── Notifications ─────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow delete: if isOwner(resource.data.userId) || isSuperAdmin();
    }

    // ─── Device Tokens (FCM) ───────────────────────────────────
    match /device_tokens/{tokenId} {
      allow read: if isOwner(resource.data.uid) || isSuperAdmin();
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(resource.data.uid) || isSuperAdmin();
    }

    // ─── Announcements ─────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isActiveUser()
        && (resource.data.isActive == true
          || userRole() in resource.data.targetRoles
          || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Audit Logs ────────────────────────────────────────────
    // The trail is append-only: nobody (not even a Super Admin) can edit or
    // delete entries, and actors can only write entries attributed to
    // themselves — so a compromised session cannot forge another admin's trail.
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action in [
          'SUPERADMIN_UPDATED_STUDENT_PROFILE',
          'SUPERADMIN_UPDATED_FACILITATOR_PROFILE',
          'SUPERADMIN_UPDATED_ADMIN_PROFILE',
          'SUPERADMIN_CHANGED_PASSWORD',
          'SUPERADMIN_UPDATED_ACCOUNT_NAME',
          'SUPERADMIN_CREATED_RESOURCE',
          'SUPERADMIN_UPDATED_RESOURCE',
          'SUPERADMIN_DELETED_RESOURCE',
          'SUPERADMIN_CREATED_CAMPUS',
          'SUPERADMIN_UPDATED_CAMPUS',
          'SUPERADMIN_SET_ASSESSMENT_OVERRIDE',
          'SUPERADMIN_REMOVED_ASSESSMENT_OVERRIDE'
        ]
        && request.resource.data.resource in ['profiles', 'users', 'auth', 'resources', 'campuses', 'assessment_overrides'];
      allow update, delete: if false;
    }

    // ─── Risk Alerts (facilitator feature) ─────────────────────
    match /risk_alerts/{alertId} {
      allow read: if isSuperAdmin()
        || (resource.data.facilitatorId == request.auth.uid && isAssignedFacilitator(resource.data.studentId))
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isSuperAdmin()
        || (request.resource.data.facilitatorId == request.auth.uid && isAssignedFacilitator(request.resource.data.studentId));
      allow update: if isSuperAdmin()
        || (resource.data.facilitatorId == request.auth.uid && isAssignedFacilitator(resource.data.studentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['open', 'acknowledged', 'resolved']);
      allow delete: if isSuperAdmin();
    }

    // ─── Appointments ──────────────────────────────────────────
    match /appointments/{appointmentId} {
      // Students can read their own appointments plus active appointment records for availability checks.
      allow read: if isSuperAdmin()
        || (isFacilitator() && resource.data.facilitatorId == request.auth.uid)
        || (isStudent()
          && (
            resource.data.studentId == request.auth.uid
            || (resource.data.status in ['requested', 'accepted'] && resource.data.facilitatorId is string)
          ));
      // Booking and rescheduling must pass the backend overlap transaction.
      allow create: if false;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['studentId', 'facilitatorId', 'scheduledAt', 'durationMinutes'])
        && (
          ((isSuperAdmin() || (isFacilitator() && resource.data.facilitatorId == request.auth.uid))
            && (request.resource.data.status != 'accepted' || resource.data.status == 'accepted')
            && (resource.data.status in ['requested', 'accepted']
              || !(request.resource.data.status in ['requested', 'accepted'])))
          || (isStudent()
            && resource.data.studentId == request.auth.uid
            && resource.data.status == 'requested'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancellationReason', 'updatedAt']))
        );
      allow delete: if isSuperAdmin();
    }

    // ─── Facilitator-Student Links ─────────────────────────────
    match /facilitator_student_links/{linkId} {
      allow read: if isSuperAdmin()
        || (isFacilitator() && resource.data.facilitatorId == request.auth.uid)
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if validLink(linkId, request.resource.data)
        && (isSuperAdmin()
          || (isStudent() && request.resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.requestedAt == request.time
            && !request.resource.data.keys().hasAny(['respondedAt'])));
      allow update: if validLink(linkId, request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'facilitatorId', 'requestedAt', 'createdAt'])
        && (isSuperAdmin()
          || (isFacilitator() && resource.data.facilitatorId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.respondedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt'])));
      allow delete: if isSuperAdmin();
    }

    // ─── Conversations & Messages ──────────────────────────────
    match /conversations/{conversationId} {
      // Reads may only look at resource.data (request.resource is null on reads).
      // `resource == null` lets the get-then-create transactions (appointment
      // acceptance, ensureConversation) probe a conversation that doesn't exist yet.
      allow read: if isSuperAdmin() || isActiveUser()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      // Participants may only touch last-message metadata and unread counts;
      // participantIds can never be changed by a client update.
      allow update: if isActiveUser()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageAt',
          'lastMessagePreview',
          'lastMessageId',
          'lastMessageSenderId',
          'lastMessageType',
          'unreadCount',
          'updatedAt',
        ]);
      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if isSuperAdmin();
    }

    match /messages/{messageId} {
      // Only conversation participants or super admins may read messages.
      // The conversationId on each message maps to a conversation document
      // that lists participantIds.
      allow read: if isActiveUser()
        && (isSuperAdmin()
          || resource.data.senderId == request.auth.uid
          || exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
            && get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid]));
      allow create: if isActiveUser()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isActiveUser()
        && exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
        && get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt'])
        && (
          !resource.data.keys().hasAny(['readBy'])
          || (
            request.resource.data.readBy.hasAll(resource.data.readBy)
            && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
          )
        )
        && request.resource.data.readBy.hasAny([request.auth.uid]);
      allow delete: if isSuperAdmin();
    }

    // ─── Work Hours Schedules ──────────────────────────────────
    match /work_hours_schedules/{scheduleId} {
      allow read: if isFacilitatorOrAdmin()
        || (isActiveUser() && resource.data.facilitatorId != null);
      allow create: if isFacilitator()
        && request.resource.data.facilitatorId == request.auth.uid;
      allow update: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
      allow delete: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
    }

    // ─── Appointment Slots ─────────────────────────────────────
    match /appointment_slots/{slotId} {
      // Any active user can read available slots
      allow read: if isActiveUser()
        && (resource.data.status == 'available' || isFacilitatorOrAdmin());
      // Facilitators can read all their own slots
      allow read: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
      // Facilitators manage their own slots
      allow create: if isFacilitator()
        && request.resource.data.facilitatorId == request.auth.uid;
      allow update: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid
        && resource.data.status == 'available';
      allow delete: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid
        && resource.data.status == 'available';
      // Students can reserve available slots
      allow update: if isStudent()
        && resource.data.status == 'available'
        && request.resource.data.status == 'reserved'
        && request.resource.data.appointmentId is string;
    }

    // ─── Assessment Templates (Phase 3A) ───────────────────────
    match /assessment_templates/{templateId} {
      allow read: if isActiveUser()
        && (resource.data.isActive == true || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Assessment Questions (Phase 3A) ───────────────────────
    match /assessment_questions/{questionId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Assessments (Phase 3A + Phase 3B) ─────────────────────
    match /assessments/{assessmentId} {
      allow read: if isActiveUser()
        && (
          resource.data.get('studentId', '') == request.auth.uid
          || (!resource.data.keys().hasAny(['studentId']) && resource.data.get('isPublished', false) == true)
          || isSuperAdmin()
          || (resource.data.keys().hasAny(['studentId']) && isAssignedFacilitator(resource.data.studentId))
        );
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'templateId', 'studentId', 'status', 'submittedAt', 'responseCount', 'createdAt', 'updatedAt']);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (studentIdentityUnchanged() && isAssignedFacilitator(resource.data.studentId))
        || (studentIdentityUnchanged() && isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'in_progress');
      allow delete: if isSuperAdmin() || isAssignedFacilitator(resource.data.studentId);
    }

    // ─── Assessment Responses (Phase 3A) ───────────────────────
    match /assessment_responses/{responseId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || canReadStudent(resource.data.studentId));
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if studentIdentityUnchanged() && isStudent()
        && resource.data.studentId == request.auth.uid;
      allow delete: if canReadStudent(resource.data.studentId);
    }

    // ─── Assessment AI Summaries (facilitator-only, server-written) ──
    // Written exclusively by the generateAssessmentSummary Cloud Function
    // (Admin SDK bypasses rules), so clients can never create or edit one.
    match /assessment_ai_summaries/{summaryId} {
      allow read: if isSuperAdmin()
        || isAssignedFacilitator(get(/databases/$(database)/documents/assessment_attempts/$(summaryId)).data.studentId);
      allow write: if false;
    }

    // ─── Assessment attempt-limit overrides ────────────────────
    // Document id: {assessmentId}_{studentId}. Only an active super admin may
    // create, change or remove one; facilitators and students are read-only
    // (students read their own).
    match /assessment_overrides/{overrideId} {
      allow read: if canReadStudent(resource.data.studentId)
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update: if isSuperAdmin() && validAttemptOverride(overrideId, request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Exactly the fields the mobile app reads, with a 1-10 whole-number cap,
    // a non-blank reason, the writer's own uid and a server timestamp.
    function validAttemptOverride(overrideId, data) {
      return data.keys().hasOnly(['assessmentId', 'studentId', 'maxAttemptsOverride', 'grantedBy', 'grantedAt', 'reason'])
        && data.keys().hasAll(['assessmentId', 'studentId', 'maxAttemptsOverride', 'grantedBy', 'grantedAt', 'reason'])
        && data.assessmentId is string
        && data.studentId is string
        && overrideId == data.assessmentId + '_' + data.studentId
        && data.maxAttemptsOverride is int
        && data.maxAttemptsOverride >= 1
        && data.maxAttemptsOverride <= 10
        && data.grantedBy == request.auth.uid
        && data.grantedAt == request.time
        && data.reason is string
        && data.reason.size() <= 500
        && data.reason.matches('(?s).*\\S.*')
        && get(/databases/$(database)/documents/users/$(data.studentId)).data.role == 'student';
    }

    // Limit check used by assessment_attempts create (see below).
    function attemptWithinLimit(attemptId, data) {
      return data.assessmentId is string
        && data.studentId is string
        && data.attemptNumber is int
        && data.attemptNumber >= 1
        && attemptId == data.assessmentId + '_' + data.studentId + '_' + string(data.attemptNumber)
        && data.attemptNumber <= effectiveMaxAttempts(data.assessmentId, data.studentId)
        && (data.attemptNumber == 1
          || get(/databases/$(database)/documents/assessment_attempts/$(data.assessmentId + '_' + data.studentId + '_' + string(data.attemptNumber - 1)))
              .data.status in ['submitted', 'graded']);
    }

    function effectiveMaxAttempts(assessmentId, studentId) {
      return exists(/databases/$(database)/documents/assessment_overrides/$(assessmentId + '_' + studentId))
          && get(/databases/$(database)/documents/assessment_overrides/$(assessmentId + '_' + studentId)).data.maxAttemptsOverride is int
          && get(/databases/$(database)/documents/assessment_overrides/$(assessmentId + '_' + studentId)).data.maxAttemptsOverride > 0
        ? get(/databases/$(database)/documents/assessment_overrides/$(assessmentId + '_' + studentId)).data.maxAttemptsOverride
        : get(/databases/$(database)/documents/assessments/$(assessmentId)).data.maxAttempts;
    }

    // ─── Assessment Attempts (Phase 3B) ────────────────────────
    match /assessment_attempts/{attemptId} {
      allow read: if canReadStudent(resource.data.studentId)
        || (isStudent() && resource.data.studentId == request.auth.uid);
      // Server-side attempt limit. The id must be {assessmentId}_{studentId}_{n} with
      // attemptNumber == n, n must be 1 or follow a submitted/graded attempt n-1, and
      // n may not exceed the effective limit: the student's override when one exists
      // (> 0), otherwise the assessment's maxAttempts. In-progress attempts are
      // resumed with reads/updates, so they never hit this create rule again.
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && attemptWithinLimit(attemptId, request.resource.data);
      allow update: if isSuperAdmin()
        || (studentIdentityUnchanged() && isAssignedFacilitator(resource.data.studentId))
        || (studentIdentityUnchanged() && isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'in_progress'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'feedback'])
          && (request.resource.data.status == 'in_progress' || request.resource.data.status == 'submitted'));
      allow delete: if canReadStudent(resource.data.studentId);
    }
  }
}
