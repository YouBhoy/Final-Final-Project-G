rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // â”€â”€â”€ Helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.isActive == true;
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isStudent() {
      return isActiveUser() && userRole() == 'student';
    }

    function isFacilitator() {
      return isActiveUser() && userRole() == 'facilitator';
    }

    function isSuperAdmin() {
      return isActiveUser() && userRole() == 'super_admin';
    }

    function isFacilitatorOrAdmin() {
      return isFacilitator() || isSuperAdmin();
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // â”€â”€â”€ Users â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /users/{userId} {
      allow read: if isOwner(userId)
        || isFacilitatorOrAdmin()
        || (isStudent() && resource.data.role == 'facilitator' && resource.data.isActive == true);
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.isActive == true;
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive'])
        || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // â”€â”€â”€ Profiles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /profiles/{userId} {
      allow read: if isOwner(userId)
        || isFacilitatorOrAdmin()
        || (isStudent() && resource.data.role == 'facilitator' && resource.data.isActive == true);
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // â”€â”€â”€ Courses â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /courses/{courseId} {
      allow read: if isActiveUser()
        && (resource.data.isPublished == true || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Enrollments â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /enrollments/{enrollmentId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || isFacilitatorOrAdmin());
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Assignments â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /assignments/{assignmentId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Submissions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /submissions/{submissionId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || isFacilitatorOrAdmin());
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'feedback']));
      allow delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Notifications â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if isFacilitatorOrAdmin();
      allow delete: if isOwner(resource.data.userId) || isSuperAdmin();
    }

    // â”€â”€â”€ Device Tokens (FCM) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /device_tokens/{tokenId} {
      allow read: if isOwner(resource.data.uid) || isSuperAdmin();
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(resource.data.uid) || isSuperAdmin();
    }

    // â”€â”€â”€ Announcements â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /announcements/{announcementId} {
      allow read: if isActiveUser()
        && (resource.data.isActive == true
          || userRole() in resource.data.targetRoles
          || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Audit Logs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isFacilitatorOrAdmin();
      allow update, delete: if false;
    }

    // â”€â”€â”€ Risk Alerts (facilitator feature) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /risk_alerts/{alertId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update: if isFacilitatorOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // â”€â”€â”€ Appointments â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /appointments/{appointmentId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'requested'
        || isFacilitatorOrAdmin();
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'requested'
          && (request.resource.data.status == 'cancelled'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['facilitatorNotes', 'outcomeNotes'])
        );
      allow delete: if isSuperAdmin();
    }

    // â”€â”€â”€ Facilitator-Student Links â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /facilitator_student_links/{linkId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid
          && resource.data.status == 'pending');
      allow delete: if isSuperAdmin();
    }

    // â”€â”€â”€ Conversations & Messages â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /conversations/{conversationId} {
      allow read, update: if isActiveUser()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.participantIds;
      allow delete: if isSuperAdmin();
    }

    match /messages/{messageId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.senderId == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // â”€â”€â”€ Work Hours Schedules â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /work_hours_schedules/{scheduleId} {
      allow read: if isFacilitatorOrAdmin()
        || (isActiveUser() && resource.data.facilitatorId != null);
      allow create: if isFacilitator()
        && request.resource.data.facilitatorId == request.auth.uid;
      allow update: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
      allow delete: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
    }

    // â”€â”€â”€ Appointment Slots â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /appointment_slots/{slotId} {
      // Students can read available slots for any facilitator
      allow read: if isActiveUser()
        && (resource.data.status == 'available' || isFacilitatorOrAdmin());
      // Facilitators can read all their own slots (available, reserved, completed, cancelled)
      allow read: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
      // Facilitators manage their own available slots
      allow create: if isFacilitator()
        && request.resource.data.facilitatorId == request.auth.uid;
      allow update: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid
        && resource.data.status == 'available';
      allow delete: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid
        && resource.data.status == 'available';
    }

    // â”€â”€â”€ Assessment Templates (Phase 3A) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /assessment_templates/{templateId} {
      allow read: if isActiveUser()
        && (resource.data.isActive == true || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Assessment Questions (Phase 3A) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /assessment_questions/{questionId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Assessments (Phase 3A + Phase 3B) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Phase 3A: student attempt shells (has studentId + templateId + status)
    // Phase 3B: course-based assessment definitions (has courseId + facilitatorId + isPublished + questions)
    // Students can read:
    //   - Phase 3A: their own assessment attempts (studentId matches)
    //   - Phase 3B: published assessment definitions (isPublished == true)
    // Facilitators/admins can read/create/update/delete all.
    match /assessments/{assessmentId} {
      allow read: if isActiveUser()
        && (
          // Phase 3A: student's own attempt
          resource.data.studentId == request.auth.uid
          // Phase 3B: published assessment definition (any active user)
          || resource.data.isPublished == true
          // Facilitator/admin override
          || isFacilitatorOrAdmin()
        );
      // Phase 3A: students creating their own attempt shells
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      // Phase 3B: only super admins can create assessment definitions
      allow create: if isSuperAdmin();
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'in_progress');
      allow delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Assessment Responses (Phase 3A) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /assessment_responses/{responseId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || isFacilitatorOrAdmin());
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid;
      allow delete: if isFacilitatorOrAdmin();
    }

    // â”€â”€â”€ Assessment Attempts (Phase 3B) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /assessment_attempts/{attemptId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress';
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'in_progress'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'feedback'])
          && (request.resource.data.status == 'in_progress' || request.resource.data.status == 'submitted'));
      allow delete: if isFacilitatorOrAdmin();
    }
  }
}
