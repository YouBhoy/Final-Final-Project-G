rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.isActive == true;
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isStudent() {
      return isActiveUser() && userRole() == 'student';
    }

    function isFacilitator() {
      return isActiveUser() && userRole() == 'facilitator';
    }

    function isSuperAdmin() {
      return isActiveUser() && userRole() == 'super_admin';
    }

    function isFacilitatorOrAdmin() {
      return isFacilitator() || isSuperAdmin();
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId)
        || isFacilitatorOrAdmin()
        || (isStudent() && resource.data.role == 'facilitator' && resource.data.isActive == true);
      allow create: if request.resource.data.role in ['student', 'facilitator', 'super_admin']
        && request.resource.data.isActive == true;
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive'])
        || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Profiles ──────────────────────────────────────────────
    match /profiles/{userId} {
      allow read: if isOwner(userId)
        || isFacilitatorOrAdmin()
        || (isStudent() && get(/databases/$(database)/documents/users/$(userId)).data.role == 'facilitator' && get(/databases/$(database)/documents/users/$(userId)).data.isActive == true);
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Courses ───────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isActiveUser()
        && (resource.data.isPublished == true || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Enrollments ───────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || isFacilitatorOrAdmin());
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isFacilitatorOrAdmin();
    }

    // ─── Assignments ───────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Submissions ───────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || isFacilitatorOrAdmin());
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'feedback']));
      allow delete: if isFacilitatorOrAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, update: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow delete: if isOwner(resource.data.userId) || isSuperAdmin();
    }

    // ─── Device Tokens (FCM) ───────────────────────────────────
    match /device_tokens/{tokenId} {
      allow read: if isOwner(resource.data.uid)
        || isSuperAdmin()
        || (isAuthenticated() && (
          exists(/databases/$(database)/documents/conversations/$(request.auth.uid + '_' + resource.data.uid))
          || exists(/databases/$(database)/documents/conversations/$(resource.data.uid + '_' + request.auth.uid))
          || exists(/databases/$(database)/documents/facilitator_student_links/$(request.auth.uid + '_' + resource.data.uid))
          || exists(/databases/$(database)/documents/facilitator_student_links/$(resource.data.uid + '_' + request.auth.uid))
        ));
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(resource.data.uid) || isSuperAdmin();
    }

    // ─── Announcements ─────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isActiveUser()
        && (resource.data.isActive == true
          || userRole() in resource.data.targetRoles
          || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Audit Logs ────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isFacilitatorOrAdmin();
      allow update, delete: if false;
    }

    // ─── Risk Alerts (facilitator feature) ─────────────────────
    match /risk_alerts/{alertId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update: if isFacilitatorOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── Assessment Overrides (facilitator feature) ──────────────
    match /assessment_overrides/{overrideId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isFacilitatorOrAdmin()
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.maxAttemptsOverride is int
        && request.resource.data.maxAttemptsOverride >= 1
        && request.resource.data.maxAttemptsOverride <= 10;
      allow update: if isFacilitatorOrAdmin()
        && request.resource.data.maxAttemptsOverride is int
        && request.resource.data.maxAttemptsOverride >= 1
        && request.resource.data.maxAttemptsOverride <= 10;
      allow delete: if isSuperAdmin();
    }

    // ─── Appointments ──────────────────────────────────────────
    match /appointments/{appointmentId} {
      // Students can read their own appointments plus active appointment records for availability checks.
      allow read: if isFacilitatorOrAdmin()
        || (isStudent()
          && (
            resource.data.studentId == request.auth.uid
            || (resource.data.status in ['requested', 'accepted'] && resource.data.facilitatorId is string)
          ));
      // Students can create appointment requests
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.facilitatorId is string;
      // Facilitators manage appointments; students can cancel their own requested ones or reschedule from a reschedule request
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'requested'
          && request.resource.data.status == 'cancelled'
        )
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'reschedule_requested'
          && request.resource.data.status == 'requested'
        );
      allow delete: if isSuperAdmin();
    }

    // ─── Facilitator-Student Links ─────────────────────────────
    match /facilitator_student_links/{linkId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isFacilitatorOrAdmin()
        || (isStudent()
          && request.resource.data.studentId == request.auth.uid);
      allow update: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid
          && resource.data.status == 'pending');
      allow delete: if isSuperAdmin();
    }

    // ─── Conversations & Messages ──────────────────────────────
    match /conversations/{conversationId} {
      // Read: allow existence-check reads even if document doesn't exist yet;
      // otherwise require participant membership.
      allow read: if isActiveUser()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participantIds);
      // Create: user must be one of the participants being added
      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.participantIds;
      // Update: user must be participant AND only allowed metadata fields can change
      allow update: if isActiveUser()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageAt',
          'lastMessagePreview',
          'lastMessageId',
          'lastMessageSenderId',
          'lastMessageType',
          'unreadCount',
          'updatedAt',
        ]);
      allow delete: if isSuperAdmin();
    }

    match /messages/{messageId} {
      // Only conversation participants or super admins may read messages.
      // The conversationId on each message maps to a conversation document
      // that lists participantIds.
      allow read: if isActiveUser()
        && (isSuperAdmin()
          || resource.data.senderId == request.auth.uid
          || exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
            && get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid]));
      allow create: if isActiveUser()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isActiveUser()
        && exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
        && get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt'])
        && (
          !resource.data.keys().hasAny(['readBy'])
          || (
            request.resource.data.readBy.hasAll(resource.data.readBy)
            && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
          )
        )
        && request.resource.data.readBy.hasAny([request.auth.uid]);
      allow delete: if isSuperAdmin();
    }

    // ─── Work Hours Schedules ──────────────────────────────────
    match /work_hours_schedules/{scheduleId} {
      allow read: if isFacilitatorOrAdmin()
        || (isActiveUser() && resource.data.facilitatorId != null);
      allow create: if isFacilitator()
        && request.resource.data.facilitatorId == request.auth.uid;
      allow update: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
      allow delete: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
    }

    // ─── Appointment Slots ─────────────────────────────────────
    match /appointment_slots/{slotId} {
      // Any active user can read available slots
      allow read: if isActiveUser()
        && (resource.data.status == 'available' || isFacilitatorOrAdmin());
      // Facilitators can read all their own slots
      allow read: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid;
      // Facilitators manage their own slots
      allow create: if isFacilitator()
        && request.resource.data.facilitatorId == request.auth.uid;
      allow update: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid
        && resource.data.status == 'available';
      allow delete: if isFacilitator()
        && resource.data.facilitatorId == request.auth.uid
        && resource.data.status == 'available';
      // Students can reserve available slots
      allow update: if isStudent()
        && resource.data.status == 'available'
        && request.resource.data.status == 'reserved'
        && request.resource.data.appointmentId is string;
    }

    // ─── Assessment Templates (Phase 3A) ───────────────────────
    match /assessment_templates/{templateId} {
      allow read: if isActiveUser()
        && (resource.data.isActive == true || isFacilitatorOrAdmin());
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Assessment Questions (Phase 3A) ───────────────────────
    match /assessment_questions/{questionId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isFacilitatorOrAdmin();
    }

    // ─── Assessments (Phase 3A + Phase 3B) ─────────────────────
    match /assessments/{assessmentId} {
      allow read: if isActiveUser()
        && (
          resource.data.studentId == request.auth.uid
          || resource.data.isPublished == true
          || isFacilitatorOrAdmin()
        );
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow create: if isSuperAdmin();
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'in_progress');
      allow delete: if isFacilitatorOrAdmin();
    }

    // ─── Assessment Responses (Phase 3A) ───────────────────────
    match /assessment_responses/{responseId} {
      allow read: if isActiveUser()
        && (resource.data.studentId == request.auth.uid || isFacilitatorOrAdmin());
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid;
      allow delete: if isFacilitatorOrAdmin();
    }

    // ─── Assessment AI Summaries (facilitator-only) ──────────────
    match /assessment_ai_summaries/{summaryId} {
      allow read: if isFacilitatorOrAdmin();
      allow create, update: if isFacilitatorOrAdmin()
        && request.resource.data.attemptId is string
        && request.resource.data.summary is string;
      allow delete: if isSuperAdmin();
    }

    // ─── Assessment Attempts (Phase 3B) ────────────────────────
    match /assessment_attempts/{attemptId} {
      allow read: if isFacilitatorOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'in_progress';
      allow update: if isFacilitatorOrAdmin()
        || (isStudent()
          && resource.data.studentId == request.auth.uid
          && resource.data.status == 'in_progress'
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'feedback'])
          && (request.resource.data.status == 'in_progress' || request.resource.data.status == 'submitted'));
      allow delete: if isFacilitatorOrAdmin();
    }
  }
}