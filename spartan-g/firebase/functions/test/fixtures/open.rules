rules_version = '2';
// TEST FIXTURE ONLY — used by the emulator smoke test (firebase.smoke-test.json).
// It opens everything on purpose so the smoke test can exercise the real client code
// without signing in. The real rules are tested by the other suites. Never deploy this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
